---
import Instagram from './icones/Instagram.astro';
import { SITE, CONTATO } from '../config/site';

const caminho = Astro.url.pathname;

/** Um item é o atual quando a URL começa com o caminho dele — menos a home,
 *  que só é a atual quando a URL é exatamente "/". */
const atual = (alvo: string) => (alvo === '/' ? caminho === '/' : caminho.startsWith(alvo));

const itens = [
  /* Abaixo de 360px não cabem a marca e os dois itens; "Início" é o que sai,
     porque a própria marca já leva para a home. */
  { rotulo: 'Início', href: '/', classe: 'hidden xs:flex' },
  { rotulo: 'Eventos', href: '/#ultimos-eventos', classe: 'flex' },
];
---

<header
  transition:persist
  class="sticky top-0 z-50 border-b border-creme-300/70 bg-creme-100/85 backdrop-blur-md"
>
  {/* Uma linha só em qualquer largura. A conta em 320px (280px úteis):
      marca 150 + intervalo 12 + navegação 108 = 270. O ícone do Instagram
      só entra a partir de 640px — no celular ele aparece logo abaixo, na
      capa, na seção de contato e no rodapé. */}
  <div
    class="container-site flex min-h-16 items-center justify-between gap-x-3 py-2 md:min-h-20"
  >
    <a
      href="/"
      data-marca
      class="min-w-0 rounded-lg leading-tight"
      aria-current={atual('/') ? 'page' : undefined}
    >
      <span
        class="block font-display text-[0.9375rem] font-700 text-texto transition-colors duration-200 sm:text-lg md:text-xl"
        >{SITE.nome}</span
      >
      <span class="mt-0.5 block text-xs text-texto-suave">{SITE.igreja}</span>
    </a>

    <nav aria-label="Principal" class="flex shrink-0 items-center gap-0.5 sm:gap-2">
      {
        itens.map((item) => (
          <a
            href={item.href}
            data-nav={item.href}
            data-ativo={atual(item.href) ? '' : undefined}
            aria-current={atual(item.href) ? 'page' : undefined}
            class:list={['min-h-11 items-center px-0.5', item.classe]}
          >
            {/* o fundo fica no span e não no link: o link guarda os 44px de
                alvo de toque, o span desenha uma pílula com proporção de
                pílula — em 14px de texto, 44px de altura viraria um círculo */}
            <span class="rounded-full px-2.5 py-1.5 font-display text-sm font-600 transition sm:px-4 sm:py-2 sm:text-base">
              {item.rotulo}
            </span>
          </a>
        ))
      }
      {
        CONTATO.instagramUrl && (
          <a
            href={CONTATO.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden size-11 shrink-0 items-center justify-center rounded-full text-tinta-700 transition hover:bg-creme-200 hover:text-primaria sm:flex"
          >
            <Instagram class="size-6" />
            <span class="sr-only">Instagram do departamento (abre em nova aba)</span>
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  /* O estado ativo vive em [data-ativo] e não em classes utilitárias, porque
     o cabeçalho é persistido entre navegações: o script abaixo precisa
     conseguir corrigi-lo trocando um atributo só. */
  [data-nav] > span {
    color: var(--color-tinta-700);
  }

  [data-nav]:hover > span {
    background-color: var(--color-creme-200);
  }

  [data-nav][data-ativo] > span {
    background-color: var(--color-ceu-100);
    color: var(--color-ceu-800);
  }

  [data-nav][data-ativo]:hover > span {
    background-color: var(--color-ceu-200);
  }

  [data-marca]:hover span:first-child {
    color: var(--color-primaria-forte);
  }
</style>

<script>
  /* transition:persist mantém este cabeçalho vivo entre as páginas, o que
     evita ele piscar — mas também congela o item marcado como atual no
     estado da página anterior. Aqui ele é reajustado a cada navegação. */
  function sincronizarNavegacao() {
    const caminho = window.location.pathname;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-nav]')) {
      const alvo = link.dataset.nav ?? '/';
      const ativo = alvo === '/' ? caminho === '/' : caminho.startsWith(alvo);

      link.toggleAttribute('data-ativo', ativo);
      if (ativo) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }

    const marca = document.querySelector<HTMLAnchorElement>('[data-marca]');
    if (marca) {
      if (caminho === '/') marca.setAttribute('aria-current', 'page');
      else marca.removeAttribute('aria-current');
    }
  }

  document.addEventListener('astro:page-load', sincronizarNavegacao);
</script>
