---
import { Image } from 'astro:assets';
import { SITE, NAVEGACAO } from '../config/site';
import logo from '../assets/marca/logo-escura.png';

const caminho = Astro.url.pathname;

/** Um item é o atual quando a URL começa com o caminho dele, menos a home,
 *  que só é a atual quando a URL é exatamente "/". Os itens de âncora nunca
 *  batem, e é isso mesmo: eles apontam para pedaços da home. */
const atual = (alvo: string) => (alvo === '/' ? caminho === '/' : caminho.startsWith(alvo));
---

<header
  transition:persist
  class="sticky top-0 z-50 border-b border-creme-300/70 bg-creme-100/85 backdrop-blur-md"
>
  <div class="container-site flex min-h-16 items-center justify-between gap-3 py-2 md:min-h-20">
    <a
      href="/"
      data-marca
      class="shrink-0 origin-left rounded-lg transition-transform duration-200 ease-saida active:scale-[0.97] active:duration-75"
      aria-current={atual('/') ? 'page' : undefined}
    >
      <Image
        src={logo}
        alt={`${SITE.nome}, ${SITE.igreja}`}
        widths={[160, 224, 320]}
        sizes="7rem"
        format="webp"
        loading="eager"
        decoding="async"
        class="h-auto w-24 md:w-28"
      />
    </a>

    {/* Quatro itens não cabem numa linha de celular junto com a marca, então
        abaixo de lg eles vivem no painel que abre no botão ao lado. */}
    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        NAVEGACAO.itens.map((item) => (
          <a
            href={item.href}
            data-nav={item.href}
            data-ativo={atual(item.href) ? '' : undefined}
            aria-current={atual(item.href) ? 'page' : undefined}
            class="flex min-h-11 items-center px-0.5"
          >
            <span
              data-pilula
              class="rounded-full px-3 py-2 font-display font-600 transition duration-200 ease-saida active:scale-95 active:duration-75"
            >
              {item.rotulo}
            </span>
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      data-menu
      aria-expanded="false"
      aria-controls="menu-navegacao"
      class="flex size-11 shrink-0 items-center justify-center rounded-full text-tinta-700 transition duration-200 ease-saida hover:bg-creme-200 hover:text-primaria active:scale-90 active:duration-75 lg:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        class="size-6"
      >
        <path data-barras d="M4 7h16M4 12h16M4 17h16"></path>
        <path data-xis class="hidden" d="m6 6 12 12M18 6 6 18"></path>
      </svg>
      <span class="sr-only" data-menu-rotulo>Abrir o menu</span>
    </button>
  </div>

  <div id="menu-navegacao" hidden class="border-t border-creme-300/70 lg:hidden">
    <nav aria-label="Principal" class="container-site flex flex-col py-2">
      {
        NAVEGACAO.itens.map((item) => (
          <a
            href={item.href}
            data-nav={item.href}
            data-ativo={atual(item.href) ? '' : undefined}
            aria-current={atual(item.href) ? 'page' : undefined}
            class="block active:scale-[0.98] active:duration-75"
          >
            <span
              data-pilula
              class="block rounded-xl px-3 py-3 font-display font-600 transition duration-200 ease-saida"
            >
              {item.rotulo}
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* O estado ativo vive em [data-ativo] e não em classes utilitárias, porque
     o cabeçalho é persistido entre navegações: o script abaixo precisa
     conseguir corrigi-lo trocando um atributo só.

     Quem pinta é sempre o span de dentro. O <a> é só o alvo de toque; se ele
     também pintasse, sobrava um bloco quadrado atrás da pílula. */
  [data-pilula] {
    color: var(--color-tinta-700);
  }

  [data-nav]:hover [data-pilula] {
    background-color: var(--color-creme-200);
  }

  [data-nav][data-ativo] [data-pilula] {
    background-color: var(--color-ceu-100);
    color: var(--color-ceu-800);
  }

  [data-nav][data-ativo]:hover [data-pilula] {
    background-color: var(--color-ceu-200);
  }
</style>

<script>
  /* transition:persist mantém este cabeçalho vivo entre as páginas, o que
     evita ele piscar, mas também congela o item marcado como atual no estado
     da página anterior. Aqui ele é reajustado a cada navegação. */
  function sincronizarNavegacao() {
    const caminho = window.location.pathname;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-nav]')) {
      const alvo = link.dataset.nav ?? '/';
      const ativo = alvo === '/' ? caminho === '/' : caminho.startsWith(alvo);

      link.toggleAttribute('data-ativo', ativo);
      if (ativo) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }

    const marca = document.querySelector<HTMLAnchorElement>('[data-marca]');
    if (marca) {
      if (caminho === '/') marca.setAttribute('aria-current', 'page');
      else marca.removeAttribute('aria-current');
    }
  }

  function menu() {
    const botao = document.querySelector<HTMLButtonElement>('[data-menu]');
    const painel = document.getElementById('menu-navegacao');
    if (!botao || !painel) return;

    const barras = botao.querySelector<SVGPathElement>('[data-barras]');
    const xis = botao.querySelector<SVGPathElement>('[data-xis]');
    const rotulo = botao.querySelector<HTMLElement>('[data-menu-rotulo]');

    const mostrar = (aberto: boolean) => {
      painel.hidden = !aberto;
      botao.setAttribute('aria-expanded', String(aberto));
      barras?.classList.toggle('hidden', aberto);
      xis?.classList.toggle('hidden', !aberto);
      if (rotulo) rotulo.textContent = aberto ? 'Fechar o menu' : 'Abrir o menu';
    };

    /* montado uma vez só: o cabeçalho é persistido, então sem esta marca os
       ouvintes se acumulariam a cada navegação */
    if (!botao.dataset.montado) {
      botao.dataset.montado = 'sim';

      botao.addEventListener('click', () => mostrar(painel.hasAttribute('hidden')));

      // clicar num item leva para a seção e o menu já cumpriu o papel
      painel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) mostrar(false);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || painel.hasAttribute('hidden')) return;
        mostrar(false);
        botao.focus();
      });

      // largura de desktop mostra a navegação inteira; o painel não faz falta
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024 && !painel.hasAttribute('hidden')) mostrar(false);
      });
    }

    mostrar(false); // toda navegação começa com o menu fechado
  }

  function iniciar() {
    sincronizarNavegacao();
    menu();
  }

  document.addEventListener('astro:page-load', iniciar);
</script>
