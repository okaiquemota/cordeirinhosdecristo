---
import { Image } from 'astro:assets';
import Seta from './icones/Seta.astro';
import { periodo, dataISO } from '../lib/datas';
import { urlEvento, nomeTransicaoCapa, type Evento } from '../lib/eventos';

interface Props {
  evento: Evento;
  /** true no primeiro card visível: carrega a capa sem lazy. */
  prioridade?: boolean;
  /**
   * 'destaque' é o cartão largo, com a foto ao lado do texto. Serve para
   * quando há poucos eventos: um cartão estreito sozinho numa linha de três
   * colunas parece página quebrada, o largo parece escolha.
   */
  variante?: 'grade' | 'destaque';
}

const { evento, prioridade = false, variante = 'grade' } = Astro.props;
const { titulo, data, dataFim, resumo, capa } = evento.data;
const emDestaque = variante === 'destaque';
---

<article
  data-revelar
  class:list={[
    'group relative overflow-hidden rounded-2xl border border-borda bg-superficie shadow-suave transition duration-300 ease-saida hover:-translate-y-1 hover:shadow-cartao focus-within:-translate-y-1 focus-within:shadow-cartao',
    emDestaque ? 'flex w-full flex-col md:flex-row' : 'flex flex-col',
  ]}
>
  {/* proporção fixa: a altura do card não muda quando a imagem carrega */}
  <div
    class:list={[
      'overflow-hidden bg-creme-200',
      emDestaque ? 'aspect-[3/2] md:aspect-auto md:w-[45%] md:shrink-0' : 'aspect-[3/2]',
    ]}
  >
    <Image
      src={capa.src}
      alt={capa.alt}
      widths={emDestaque ? [480, 720, 960, 1280] : [320, 480, 640, 960]}
      sizes={
        emDestaque
          ? '(min-width: 1024px) 32rem, 92vw'
          : '(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 92vw'
      }
      format="webp"
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
      decoding="async"
      transition:name={nomeTransicaoCapa(evento)}
      class="size-full object-cover transition-transform duration-500 ease-saida group-hover:scale-[1.03]"
    />
  </div>

  <div class:list={['flex flex-1 flex-col', emDestaque ? 'p-6 md:p-9' : 'p-5']}>
    <time
      datetime={dataISO(data)}
      class="self-start rounded-full bg-ceu-100 px-3 py-1 font-display text-sm font-600 text-ceu-800"
    >
      {periodo(data, dataFim)}
    </time>

    <h3
      class:list={[
        'mt-3 font-display leading-snug font-700 text-texto',
        emDestaque ? 'text-titulo' : 'text-xl',
      ]}
    >
      {/* o link cobre o card inteiro, mas só o título é lido como o link */}
      <a href={urlEvento(evento)} class="after:absolute after:inset-0 after:content-['']">
        {titulo}
      </a>
    </h3>

    <p
      class:list={[
        'mt-2 text-tinta-700',
        emDestaque ? 'text-corpo-lg' : 'line-clamp-3',
      ]}
    >
      {resumo}
    </p>

    {/* pointer-events-none não é enfeite: no hover este span ganha
        translate-x-1, e elemento transformado vira contexto de
        empilhamento, pintado na mesma etapa dos posicionados e em ordem de
        documento. Como ele vem depois do <h3>, subia por cima da camada
        invisível que torna o card clicável e comia o clique justamente
        onde o convite de clicar está. */}
    <span
      class:list={[
        'pointer-events-none inline-flex items-center gap-1.5 font-display font-600 text-primaria transition-transform duration-300 ease-saida group-hover:translate-x-1',
        emDestaque ? 'mt-6 text-lg' : 'mt-4',
      ]}
      aria-hidden="true"
    >
      Ver fotos
      <Seta class="size-4" />
    </span>
  </div>
</article>
