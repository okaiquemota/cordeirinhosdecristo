---
import { Image, getImage } from 'astro:assets';

interface Foto {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  fotos: Foto[];
  /** "grade" é a galeria do evento; "unica" é uma foto só, no formato dela. */
  variante?: 'grade' | 'unica';
}

const { fotos, variante = 'grade' } = Astro.props;

/* Com uma foto só não há para onde navegar: as setas e o contador ficam
   no HTML (o script conta com eles) mas escondidos. */
const varias = fotos.length > 1;

/* Versões grandes para o lightbox, geradas no build. Nunca passamos do
   tamanho do arquivo original — ampliar só engorda o download. */
const grandes = await Promise.all(
  fotos.map(async (foto) => {
    const largura = Math.min(1800, foto.src.width);
    const imagem = await getImage({
      src: foto.src,
      width: largura,
      format: 'webp',
      quality: 82,
    });
    return {
      src: imagem.src,
      largura: imagem.attributes.width ?? largura,
      altura: imagem.attributes.height,
      alt: foto.alt,
    };
  }),
);
---

<div data-galeria>
  {
    variante === 'unica' && (
      <button
        type="button"
        data-abrir="0"
        class="group block w-full cursor-zoom-in overflow-hidden rounded-3xl bg-ceu-100 shadow-cartao transition duration-300 ease-saida hover:shadow-alta active:scale-[0.99] active:duration-100"
        style={`aspect-ratio: ${fotos[0].src.width} / ${fotos[0].src.height}`}
      >
        <Image
          src={fotos[0].src}
          alt={fotos[0].alt}
          widths={[420, 640, 900, 1200]}
          sizes="(min-width: 768px) 30rem, 92vw"
          format="webp"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 ease-saida group-hover:scale-[1.03]"
        />
        <span class="sr-only">Abrir a foto em tamanho grande</span>
      </button>
    )
  }

  <ul
    data-revelar-grupo
    class:list={['grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4', variante === 'unica' && 'hidden']}
  >
    {
      variante === 'grade' &&
        fotos.map((foto, i) => (
        <li data-revelar>
          <button
            type="button"
            data-abrir={i}
            class="group block aspect-square w-full cursor-zoom-in overflow-hidden rounded-2xl bg-creme-200 transition duration-300 ease-saida hover:-translate-y-0.5 hover:shadow-cartao active:scale-[0.97] active:duration-100"
          >
            <Image
              src={foto.src}
              alt={foto.alt}
              widths={[240, 360, 480, 720]}
              sizes="(min-width: 48rem) 23rem, 46vw"
              format="webp"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
              class="size-full object-cover transition-transform duration-500 ease-saida group-hover:scale-[1.04]"
            />
            <span class="sr-only">
              Abrir foto {i + 1} de {fotos.length} em tamanho grande
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog
    data-lightbox
    aria-label="Galeria de fotos"
    class="max-h-none max-w-none border-0 bg-transparent p-0 backdrop:bg-ceu-900/94 backdrop:backdrop-blur-md"
  >
    <div class="flex h-dvh w-dvw flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <p data-contador class="font-display font-600 text-creme-100" aria-hidden="true" hidden={!varias}></p>
        <button
          type="button"
          data-fechar
          class="rounded-full p-2.5 text-creme-100 transition hover:bg-creme-100/15"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            aria-hidden="true"
            class="size-6"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
          <span class="sr-only">Fechar galeria</span>
        </button>
      </div>

      <div data-palco class="relative flex min-h-0 flex-1 touch-none items-center justify-center px-2 pb-2 sm:px-4">
        <img
          data-foto
          alt=""
          class="max-h-full max-w-full rounded-xl object-contain"
          decoding="async"
        />

        <button
          type="button"
          data-anterior
          hidden={!varias}
          class="absolute top-1/2 left-1 -translate-y-1/2 rounded-full bg-ceu-900/60 p-3 text-creme-100 transition hover:bg-ceu-900/90 sm:left-4"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-6"
          >
            <path d="M15 5 8 12l7 7"></path>
          </svg>
          <span class="sr-only">Foto anterior</span>
        </button>

        <button
          type="button"
          data-proxima
          hidden={!varias}
          class="absolute top-1/2 right-1 -translate-y-1/2 rounded-full bg-ceu-900/60 p-3 text-creme-100 transition hover:bg-ceu-900/90 sm:right-4"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-6"
          >
            <path d="m9 5 7 7-7 7"></path>
          </svg>
          <span class="sr-only">Próxima foto</span>
        </button>
      </div>

      <p data-legenda class="sr-only" aria-live="polite"></p>
    </div>
  </dialog>

  <script is:inline type="application/json" data-fotos set:html={JSON.stringify(grandes)}></script>
</div>

<style>
  /* O backdrop nativo não herda transição, então a entrada dele é uma
     animação própria. Some junto com o movimento reduzido. */
  dialog[data-lightbox][open]::backdrop {
    animation: escurecer 0.25s ease both;
  }

  @keyframes escurecer {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[data-lightbox][open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  type FotoGrande = { src: string; largura: number; altura: number; alt: string };

  const movimentoReduzido = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function montar(raiz: HTMLElement) {
    if (raiz.dataset.montado) return;
    raiz.dataset.montado = 'sim';

    const json = raiz.querySelector('[data-fotos]')?.textContent ?? '[]';
    const fotos: FotoGrande[] = JSON.parse(json);
    if (fotos.length === 0) return;

    lightbox(raiz, fotos);
  }

  /* ── lightbox ────────────────────────────────────────────────────────
     Regras que este bloco segue, na ordem de importância:
       1. retorno contínuo DURANTE o gesto, não só no fim — a foto anda
          colada no dedo;
       2. a animação herda a velocidade de soltura, para não haver costura
          entre arrastar e animar;
       3. o destino sai da projeção do movimento, não da distância crua:
          um peteleco curto e rápido vira página, um arrasto longo e lento
          não vira;
       4. molas em vez de duração fixa, porque mola parte do valor atual e
          pode ser agarrada no meio do caminho.                            */
  function lightbox(raiz: HTMLElement, fotos: FotoGrande[]) {
    const dialogo = raiz.querySelector<HTMLDialogElement>('dialog[data-lightbox]');
    const foto = raiz.querySelector<HTMLImageElement>('[data-foto]');
    const palco = raiz.querySelector<HTMLElement>('[data-palco]');
    const contador = raiz.querySelector<HTMLElement>('[data-contador]');
    const legenda = raiz.querySelector<HTMLElement>('[data-legenda]');
    const gatilhos = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-abrir]'));
    if (!dialogo || !foto || !palco || !contador || !legenda) return;

    let atual = 0;
    let scrollTravado = '';
    /* Cada navegação pega um número. Se outra começar antes desta acabar,
       a antiga desiste na hora de trocar a imagem — o índice já andou, então
       teclar rápido acumula em vez de perder comando. */
    let token = 0;

    /* Estado do zoom. Fica aqui em cima porque trocar de foto precisa
       zerá-lo, e isso acontece bem antes do bloco de gestos. */
    let escala = 1;
    let panX = 0;
    let panY = 0;
    const ampliada = () => escala > 1.001;
    const zerarZoom = () => {
      escala = 1;
      panX = 0;
      panY = 0;
    };

    const mola = (duracao: number, salto: number, velocidade = 0) =>
      ({ type: 'spring', bounce: salto, duration: duracao, velocity: velocidade }) as const;

    /** Só troca o que está na tela. Quem move o índice é quem chama. */
    const aplicar = (i: number) => {
      const f = fotos[i];
      if (!f) return;
      zerarZoom();
      foto.src = f.src;
      foto.alt = f.alt;
      if (f.largura) foto.width = f.largura;
      if (f.altura) foto.height = f.altura;
      contador.textContent = `${i + 1} / ${fotos.length}`;
      legenda.textContent = `Foto ${i + 1} de ${fotos.length}. ${f.alt}`;
      vizinhas(i);
    };

    /* Baixa a anterior e a próxima em segundo plano, para a navegação não
       piscar em branco. */
    const vizinhas = (i: number) => {
      for (const j of [i - 1, i + 1]) {
        const f = fotos[(j + fotos.length) % fotos.length];
        if (f) new Image().src = f.src;
      }
    };

    async function abrir(i: number) {
      const miniatura = gatilhos[i]?.querySelector('img');
      const origem = miniatura?.getBoundingClientRect();

      atual = i;
      aplicar(i);
      foto!.style.transform = '';
      foto!.style.opacity = '';
      scrollTravado = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialogo!.showModal();

      if (movimentoReduzido() || !origem) return;

      /* Zoom a partir da miniatura: mede onde a imagem grande parou e anima
         dela de volta até a posição de onde o usuário clicou. */
      try {
        await foto!.decode().catch(() => undefined);
        const destino = foto!.getBoundingClientRect();
        if (destino.width === 0) return;

        const dx = origem.left + origem.width / 2 - (destino.left + destino.width / 2);
        const dy = origem.top + origem.height / 2 - (destino.top + destino.height / 2);
        const escala = Math.max(0.05, origem.width / destino.width);

        const { animate } = await import('motion');
        animate(
          foto!,
          { x: [dx, 0], y: [dy, 0], scale: [escala, 1], opacity: [0.35, 1] },
          mola(0.42, 0),
        );
      } catch {
        /* sem animação é melhor que sem lightbox */
      }
    }

    async function fechar() {
      document.body.style.overflow = scrollTravado;

      if (movimentoReduzido()) {
        dialogo!.close();
        return;
      }
      try {
        const { animate } = await import('motion');
        await animate(foto!, { opacity: 0, scale: 0.94 }, mola(0.22, 0)).finished;
      } catch {
        /* fecha mesmo assim */
      }
      dialogo!.close();
    }

    /** direcao: 1 avança, -1 volta. velocidade em px/s, para a entrega. */
    async function irPara(direcao: number, velocidade = 0) {
      // o índice anda já, antes de qualquer animação: assim dois toques
      // rápidos avançam duas fotos em vez de brigarem pela mesma
      atual = (atual + direcao + fotos.length) % fotos.length;
      const destino = atual;
      const meu = ++token;

      if (movimentoReduzido()) {
        aplicar(destino);
        foto!.style.transform = '';
        foto!.style.opacity = '';
        return;
      }

      try {
        const { animate } = await import('motion');
        const largura = palco!.clientWidth || 600;

        // sai para o lado do movimento, herdando a velocidade do dedo
        await animate(
          foto!,
          { x: -direcao * largura * 0.55, opacity: 0 },
          mola(0.26, 0, velocidade),
        ).finished;

        if (meu !== token) return; // outra navegação assumiu o comando

        aplicar(destino);

        // e a próxima entra do lado oposto, com um resto de inércia
        foto!.style.transform = `translateX(${direcao * largura * 0.45}px)`;
        animate(foto!, { x: 0, opacity: [0, 1] }, mola(0.4, 0.12));
      } catch {
        aplicar(destino);
      }
    }

    const proxima = (v = 0) => irPara(1, v);
    const anterior = (v = 0) => irPara(-1, v);

    gatilhos.forEach((botao, i) => botao.addEventListener('click', () => abrir(i)));
    raiz.querySelector('[data-fechar]')?.addEventListener('click', fechar);
    raiz.querySelector('[data-proxima]')?.addEventListener('click', () => proxima());
    raiz.querySelector('[data-anterior]')?.addEventListener('click', () => anterior());

    // clique no vazio ao redor da foto fecha
    palco.addEventListener('click', (e) => {
      if (e.target === palco && !houveArrasto) fechar();
    });

    // Esc é nativo do <dialog>; aqui ficam as setas
    dialogo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        proxima();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        anterior();
      }
    });

    // devolve o scroll se o Esc fechar sem passar por fechar()
    dialogo.addEventListener('close', () => {
      document.body.style.overflow = scrollTravado;
      zerarZoom();
      foto.style.transition = '';
      foto.style.cursor = '';
    });

    /* ── gestos ───────────────────────────────────────────────────────
       Três gestos dividem o mesmo palco, e a escala decide qual vale:

         encaixada (escala 1)   um dedo arrasta para trocar de foto
         ampliada  (escala > 1) um dedo arrasta para passear pela foto
         dois dedos             pinça, sempre

       Toque duplo alterna entre as duas. No mouse, duplo clique faz o
       mesmo, e ctrl + roda amplia (é o que o trackpad manda quando se
       faz pinça nele).

       Na troca de foto vale a projeção de inércia, igual à da rolagem:
       onde o movimento PARARIA se continuasse desacelerando. É o que faz
       um peteleco curto e rápido valer mais que um arrasto longo e
       preguiçoso.                                                        */
    const projetar = (velocidade: number, desaceleracao = 0.998) =>
      ((velocidade / 1000) * desaceleracao) / (1 - desaceleracao);

    const LIMIAR_DIRECAO = 10; // px antes de decidir se o gesto é horizontal
    const ESCALA_MAX = 4;
    const ESCALA_TOQUE_DUPLO = 2.5;
    const JANELA_TOQUE_DUPLO = 300; // ms

    /** Escreve escala e deslocamento. Encaixada, limpa o transform. */
    const desenhar = () => {
      foto.style.transform =
        escala === 1 && panX === 0 && panY === 0
          ? ''
          : `translate(${panX}px, ${panY}px) scale(${escala})`;
      foto.style.cursor = ampliada() ? 'grab' : '';
    };

    /** Impede arrastar a foto ampliada para fora da tela. */
    const limitarPan = () => {
      const maxX = Math.max(0, (foto.offsetWidth * escala - palco.clientWidth) / 2);
      const maxY = Math.max(0, (foto.offsetHeight * escala - palco.clientHeight) / 2);
      panX = Math.min(maxX, Math.max(-maxX, panX));
      panY = Math.min(maxY, Math.max(-maxY, panY));
    };

    /** Centro da foto como se não houvesse transformação, em coordenadas
        de tela. O retângulo medido já vem transformado, então desconta-se
        o deslocamento que nós mesmos aplicamos. */
    const centroBase = () => {
      const r = foto.getBoundingClientRect();
      return { x: r.left + r.width / 2 - panX, y: r.top + r.height / 2 - panY };
    };

    /** Muda a escala deixando parado o ponto (fx, fy) da tela — é isso que
        faz a pinça ampliar o que está ENTRE os dedos, e não o centro. */
    const escalarEm = (alvo: number, fx: number, fy: number) => {
      const anterior = escala;
      escala = Math.min(ESCALA_MAX, Math.max(1, alvo));
      if (escala === anterior) return;

      const base = centroBase();
      const razao = escala / anterior;
      panX = fx - base.x - (fx - base.x - panX) * razao;
      panY = fy - base.y - (fy - base.y - panY) * razao;
      limitarPan();
      desenhar();
    };

    /** Volta ao encaixe com uma transição curta. Fora de gesto, então
        transição CSS dá conta e não briga com as molas da navegação. */
    const encaixar = () => {
      zerarZoom();
      if (movimentoReduzido()) return desenhar();
      foto.style.transition = 'transform 0.32s var(--ease-saida, ease-out)';
      desenhar();
      window.setTimeout(() => {
        foto.style.transition = '';
      }, 340);
    };

    const alternarZoom = (fx: number, fy: number) => {
      if (ampliada()) encaixar();
      else escalarEm(ESCALA_TOQUE_DUPLO, fx, fy);
    };

    const pontos = new Map<number, { x: number; y: number }>();
    let arrastando = false;
    let houveArrasto = false;
    let direcaoDecidida = false;
    let horizontal = false;
    let passeando = false;
    let inicioX = 0;
    let inicioY = 0;
    let panInicioX = 0;
    let panInicioY = 0;
    let historico: Array<{ x: number; t: number }> = [];
    let pinca: { distancia: number; escala: number } | null = null;
    let ultimoToque = 0;
    let ultimoToqueX = 0;
    let ultimoToqueY = 0;

    const velocidadeAtual = () => {
      if (historico.length < 2) return 0;
      const fim = historico[historico.length - 1]!;
      let ini = historico[0]!;
      for (let i = historico.length - 2; i >= 0; i--) {
        ini = historico[i]!;
        if (fim.t - ini.t >= 30) break;
      }
      const dt = fim.t - ini.t;
      return dt > 0 ? ((fim.x - ini.x) / dt) * 1000 : 0;
    };

    /** Distância e ponto médio entre os dois primeiros dedos. */
    const dedos = () => {
      const [a, b] = [...pontos.values()];
      if (!a || !b) return null;
      return { distancia: Math.hypot(b.x - a.x, b.y - a.y), x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    };

    palco.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      foto.style.transition = '';
      pontos.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pontos.size === 2) {
        // entrou o segundo dedo: vira pinça e o arrasto em curso é abortado
        const d = dedos();
        if (d) pinca = { distancia: d.distancia, escala };
        arrastando = false;
        passeando = false;
        foto.style.opacity = '';
        desenhar();
        return;
      }
      if (pontos.size > 2) return;

      const agora = performance.now();

      // toque duplo (só no dedo; no mouse quem cuida é o dblclick)
      if (e.pointerType !== 'mouse') {
        const perto =
          Math.abs(e.clientX - ultimoToqueX) < 30 && Math.abs(e.clientY - ultimoToqueY) < 30;
        if (agora - ultimoToque < JANELA_TOQUE_DUPLO && perto) {
          ultimoToque = 0;
          alternarZoom(e.clientX, e.clientY);
          return;
        }
        ultimoToque = agora;
        ultimoToqueX = e.clientX;
        ultimoToqueY = e.clientY;
      }

      arrastando = true;
      houveArrasto = false;
      direcaoDecidida = false;
      horizontal = false;
      passeando = ampliada();
      inicioX = e.clientX;
      inicioY = e.clientY;
      panInicioX = panX;
      panInicioY = panY;
      historico = [{ x: e.clientX, t: agora }];
      if (passeando) palco.setPointerCapture(e.pointerId);
    });

    palco.addEventListener('pointermove', (e) => {
      if (!pontos.has(e.pointerId)) return;
      pontos.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pinca && pontos.size >= 2) {
        const d = dedos();
        if (d && d.distancia > 0) escalarEm((d.distancia / pinca.distancia) * pinca.escala, d.x, d.y);
        return;
      }

      if (!arrastando) return;
      const dx = e.clientX - inicioX;
      const dy = e.clientY - inicioY;

      // ampliada, o dedo passeia pela foto em vez de trocar de foto
      if (passeando) {
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) houveArrasto = true;
        panX = panInicioX + dx;
        panY = panInicioY + dy;
        limitarPan();
        desenhar();
        return;
      }

      if (!direcaoDecidida) {
        if (Math.abs(dx) < LIMIAR_DIRECAO && Math.abs(dy) < LIMIAR_DIRECAO) return;
        direcaoDecidida = true;
        horizontal = Math.abs(dx) > Math.abs(dy);
        if (!horizontal) {
          arrastando = false; // gesto vertical não é nosso
          return;
        }
        palco.setPointerCapture(e.pointerId);
      }

      houveArrasto = true;
      historico.push({ x: e.clientX, t: performance.now() });
      if (historico.length > 6) historico.shift();

      // 1:1 com o dedo, e a foto vai clareando conforme se afasta
      foto.style.transform = `translateX(${dx}px)`;
      foto.style.opacity = String(1 - Math.min(Math.abs(dx) / 700, 0.45));
    });

    async function soltar(e: PointerEvent) {
      if (!arrastando) return;
      arrastando = false;
      if (!houveArrasto || !horizontal) return;

      const dx = e.clientX - inicioX;
      const v = velocidadeAtual();
      const ondePararia = dx + projetar(v);
      const limiar = (palco!.clientWidth || 600) * 0.3;

      if (ondePararia <= -limiar) return proxima(v);
      if (ondePararia >= limiar) return anterior(v);

      // não deu: volta para o lugar, também herdando a velocidade
      if (movimentoReduzido()) {
        foto!.style.transform = '';
        foto!.style.opacity = '';
        return;
      }
      try {
        const { animate } = await import('motion');
        animate(foto!, { x: 0, opacity: 1 }, mola(0.4, 0.18, v));
      } catch {
        foto!.style.transform = '';
        foto!.style.opacity = '';
      }
    }

    const largarPonteiro = (e: PointerEvent) => {
      pontos.delete(e.pointerId);
      if (palco.hasPointerCapture?.(e.pointerId)) palco.releasePointerCapture(e.pointerId);
    };

    palco.addEventListener('pointerup', (e) => {
      const saiuDaPinca = pinca !== null;
      largarPonteiro(e);

      if (saiuDaPinca) {
        if (pontos.size < 2) {
          pinca = null;
          // afrouxou até caber de novo: encaixa em vez de deixar torto
          if (!ampliada()) encaixar();
        }
        return;
      }

      if (passeando) {
        arrastando = false;
        passeando = false;
        return;
      }

      void soltar(e);
    });

    palco.addEventListener('pointercancel', (e) => {
      largarPonteiro(e);
      if (pontos.size < 2) pinca = null;
      arrastando = false;
      passeando = false;
      if (ampliada()) return; // um dedo sumir não é motivo para perder o zoom
      foto.style.transform = '';
      foto.style.opacity = '';
    });

    foto.addEventListener('dblclick', (e) => {
      e.preventDefault();
      alternarZoom(e.clientX, e.clientY);
    });

    /* Pinça de trackpad chega como roda com ctrl. */
    palco.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey) return;
        e.preventDefault();
        escalarEm(escala * Math.exp(-e.deltaY / 240), e.clientX, e.clientY);
      },
      { passive: false },
    );
  }

  const iniciar = () =>
    document.querySelectorAll<HTMLElement>('[data-galeria]').forEach(montar);

  document.addEventListener('astro:page-load', iniciar);
</script>
