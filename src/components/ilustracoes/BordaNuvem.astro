---
/**
 * Borda de nuvens para a virada entre duas seções.
 *
 * É um aglomerado de círculos preenchidos com a cor da seção de cima,
 * apoiados numa faixa sólida. Fica em currentColor, então quem usa define
 * a cor pela classe.
 *
 * Já tentamos usar a nuvem oficial aqui, repetida como máscara CSS. Na
 * teoria era melhor — a silhueta exata da marca. Na prática ficou pior:
 * repetir uma forma só dá um desenho regular demais, e mesmo sobrepondo
 * três tamanhos o resultado continuou duro. Estes círculos de raios
 * variados leem melhor como céu. A nuvem oficial segue em uso nas nuvens
 * que derivam pelo hero e pela faixa do versículo, onde ela aparece
 * inteira e é reconhecível.
 */
interface Props {
  /** Vira a borda de cabeça para baixo: as nuvens crescem para cima. */
  virada?: boolean;
  class?: string;
}
const { virada = false, class: classe = 'text-fundo' } = Astro.props;

/* A borda sangra 1px para fora da seção, e a seção correspondente leva uma
   borda de 1px nesta mesma cor com bg-clip-padding.
   Por quê: a altura deste SVG é largura x 84/1200, quase sempre fracionária.
   Em zoom diferente de 100% a aresta do box cai no meio de um pixel do
   monitor, o navegador mistura ali o creme com o fundo da seção e sobra um
   fio de cor atravessando a página inteira. Empurrando a faixa sólida 1px
   para fora, a aresta do SVG passa a encostar em creme, não em azul. */
const sangria = virada ? 1 : -1;

/* [x, raio] — raios variados para não virar um festão regular.
   Os círculos ficam na linha de baixo da faixa e transbordam para baixo,
   então a cor clara desce sobre a seção escura em forma de nuvem. */
const bolhas: Array<[number, number]> = [
  [-16, 30], [24, 44], [74, 26],
  [132, 22], [168, 38], [212, 28],
  [268, 20], [300, 34], [342, 46], [396, 24],
  [452, 30], [492, 20], [528, 40], [578, 26],
  [630, 36], [678, 22], [714, 30],
  [768, 44], [822, 26], [860, 18],
  [906, 32], [948, 42], [1000, 24],
  [1052, 20], [1086, 36], [1132, 28], [1180, 40], [1216, 24],
];
---

<svg
  viewBox="0 0 1200 84"
  preserveAspectRatio="xMidYMin meet"
  aria-hidden="true"
  focusable="false"
  class:list={['relative block h-auto w-full', virada && '-scale-y-100', classe]}
  style={`top: ${sangria}px`}
>
  <g fill="currentColor">
    <rect x="0" y="0" width="1200" height="30"></rect>
    {bolhas.map(([x, r]) => <circle cx={x} cy={29} r={r}></circle>)}
  </g>
</svg>
