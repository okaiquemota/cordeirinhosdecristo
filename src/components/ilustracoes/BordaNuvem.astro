---
import nuvem from '../../assets/marca/nuvem.png';

/**
 * Borda de nuvens para a virada de uma seção clara para uma escura.
 *
 * Usa a nuvem oficial como máscara CSS, repetida na horizontal, somada a
 * uma faixa sólida no topo. Assim a silhueta é exatamente a da marca, mas
 * pintada na cor que a seção de cima tem — o que uma imagem branca fixa
 * não permitiria.
 */
interface Props {
  class?: string;
}
const { class: classe = 'text-fundo' } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['borda-nuvem', classe]}
  style={`--nuvem-marca: url("${nuvem.src}")`}
>
</div>

<style>
  .borda-nuvem {
    height: 3.25rem;
    background-color: currentColor;

    /* duas camadas: as nuvens repetidas e uma faixa sólida no topo, unidas */
    --faixa: linear-gradient(black, black);
    mask-image: var(--nuvem-marca), var(--faixa);
    mask-repeat: repeat-x, no-repeat;
    /* A nuvem é ancorada pela base e desenhada maior que a faixa: a parte
       larga dela fica no topo, encostando nas vizinhas, e só as bolhas de
       baixo aparecem — que é o formato de nuvem pendurada. */
    mask-size:
      auto 210%,
      100% 34%;
    mask-position:
      center bottom,
      top;
    mask-composite: add;

    -webkit-mask-image: var(--nuvem-marca), var(--faixa);
    -webkit-mask-repeat: repeat-x, no-repeat;
    -webkit-mask-size:
      auto 210%,
      100% 34%;
    -webkit-mask-position:
      center bottom,
      top;
    -webkit-mask-composite: source-over;
  }

  @media (width >= 48rem) {
    .borda-nuvem {
      height: 4.5rem;
    }
  }
</style>
