---
import nuvem from '../../assets/marca/nuvem.png';

/**
 * Borda de nuvens para a virada entre duas seções.
 *
 * Usa a nuvem oficial como máscara CSS, então a silhueta é exatamente a da
 * marca mas pintada na cor que a seção vizinha tem — uma imagem branca
 * fixa não permitiria isso.
 *
 * A nuvem é repetida em TRÊS camadas de tamanhos diferentes em vez de uma
 * só. Com uma camada, o resultado é um festão perfeitamente regular, que
 * lê como renda e não como céu. Com três larguras que não são múltiplas
 * entre si, o desenho só se repete depois de alguns metros de tela.
 */
interface Props {
  class?: string;
}
const { class: classe = 'text-fundo' } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['borda-nuvem', classe]}
  style={`--nuvem-marca: url("${nuvem.src}")`}
>
</div>

<style>
  .borda-nuvem {
    height: 3.25rem;
    background-color: currentColor;

    --n: var(--nuvem-marca);
    --faixa: linear-gradient(black, black);

    /* três tamanhos primos entre si + a faixa sólida que fecha o topo */
    mask-image: var(--n), var(--n), var(--n), var(--faixa);
    mask-repeat: repeat-x, repeat-x, repeat-x, no-repeat;
    mask-size:
      auto 250%,
      auto 190%,
      auto 145%,
      100% 30%;
    mask-position:
      13% bottom,
      61% bottom,
      37% bottom,
      top;
    mask-composite: add;

    -webkit-mask-image: var(--n), var(--n), var(--n), var(--faixa);
    -webkit-mask-repeat: repeat-x, repeat-x, repeat-x, no-repeat;
    -webkit-mask-size:
      auto 250%,
      auto 190%,
      auto 145%,
      100% 30%;
    -webkit-mask-position:
      13% bottom,
      61% bottom,
      37% bottom,
      top;
    -webkit-mask-composite: source-over;
  }

  @media (width >= 48rem) {
    .borda-nuvem {
      height: 4.5rem;
    }
  }
</style>
