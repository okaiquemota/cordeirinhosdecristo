---
import { Image } from 'astro:assets';
import ovelha from '../../assets/marca/ovelha.png';

/**
 * O rosto do cordeirinho da marca.
 *
 * É o arquivo oficial, não um desenho nosso — por isso vive em
 * src/assets/marca. Serve de elemento de apoio pelo site e é decorativo
 * em todo lugar onde aparece: alt vazio e aria-hidden, porque quem usa
 * leitor de tela não perde nada sem ele.
 */
interface Props {
  /** Classes extras (tamanho, posição). */
  class?: string;
  /** Balanço sutil contínuo. Desligado automaticamente em movimento reduzido. */
  animada?: boolean;
}
const { class: classe = 'w-24', animada = false } = Astro.props;
---

<Image
  src={ovelha}
  alt=""
  aria-hidden="true"
  width={360}
  format="webp"
  loading="lazy"
  decoding="async"
  data-decorativo
  class:list={['h-auto', classe, animada && 'origin-bottom animate-balanco']}
/>
