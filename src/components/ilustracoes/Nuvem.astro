---
import { Image } from 'astro:assets';
import nuvem from '../../assets/marca/nuvem.png';

/**
 * A nuvem da marca. Arquivo oficial, não desenho nosso.
 */
interface Props {
  class?: string;
  /** Opacidade — nuvens de fundo pedem valores baixos. */
  opacidade?: number;
  /**
   * Atraso da animação, em segundos. Use valores negativos para começar a
   * deriva já no meio do caminho: sem isso todas as nuvens saem do mesmo
   * ponto ao carregar a página e andam em bloco.
   */
  atraso?: number;
}
const { class: classe = 'w-40', opacidade = 1, atraso } = Astro.props;

const estilo = [
  `opacity:${opacidade}`,
  atraso !== undefined ? `animation-delay:${atraso}s` : '',
]
  .filter(Boolean)
  .join(';');
---

<Image
  src={nuvem}
  alt=""
  aria-hidden="true"
  width={440}
  format="webp"
  loading="lazy"
  decoding="async"
  data-decorativo
  class:list={['h-auto', classe]}
  style={estilo}
/>
