---
interface Props {
  class?: string;
  /** Opacidade do preenchimento — nuvens de fundo pedem valores baixos. */
  opacidade?: number;
}
const { class: classe = 'w-40', opacidade = 1 } = Astro.props;
---

<svg
  viewBox="0 0 200 90"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-decorativo
  class:list={[classe]}
  style={`opacity:${opacidade}`}
>
