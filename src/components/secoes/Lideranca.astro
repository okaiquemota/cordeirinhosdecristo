---
import Galeria from '../Galeria.astro';
import Rabisco from '../ilustracoes/Rabisco.astro';
import { LIDERANCA } from '../../config/site';
import foto from '../../assets/fotos/lideranca.jpeg';

/* Sem parágrafo nenhum a seção não aparece — nada de buraco na página. */
const aparece = LIDERANCA.paragrafos.length > 0;
---

{
  aparece && (
    <section class="secao pt-0" aria-labelledby="lideranca">
      <div class="container-site">
        {/* O texto vem antes no HTML para quem lê com leitor de tela ouvir o
            título primeiro. No desktop a foto pula para a esquerda, e a
            seção fica espelhada em relação ao "Quem somos" logo acima. */}
        <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
          <div>
            <h2 id="lideranca" data-titulo class="text-titulo text-texto">
              {LIDERANCA.titulo}
            </h2>
            <Rabisco class="mt-3 text-rosa-300" />
            <div data-revelar class="mt-6 space-y-4 text-corpo-lg text-tinta-700">
              {LIDERANCA.paragrafos.map((paragrafo) => (
                <p>{paragrafo}</p>
              ))}
            </div>
          </div>

          <div data-revelar class="relative isolate order-first">
            {/* o papel, espelhado em relação ao do Quem somos */}
            <div
              class="absolute inset-0 -z-10 -translate-x-3 translate-y-3 rotate-3 rounded-3xl bg-rosa-200 md:-translate-x-5 md:translate-y-5"
              aria-hidden="true"
            ></div>
            <Galeria
              variante="unica"
              fotos={[
                {
                  src: foto,
                  alt: 'A equipe que cuida das crianças dos Cordeirinhos de Cristo.',
                },
              ]}
            />
          </div>
        </div>
      </div>
    </section>
  )
}
