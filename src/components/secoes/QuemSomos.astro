---
import { Image } from 'astro:assets';
import Ovelha from '../ilustracoes/Ovelha.astro';
import { QUEM_SOMOS } from '../../config/site';
import foto from '../../assets/fotos/hero.jpg';
---

<section class="secao" aria-labelledby="quem-somos">
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div data-revelar>
        <h2 id="quem-somos" class="text-titulo text-texto">{QUEM_SOMOS.titulo}</h2>
        <p class="mt-5 text-corpo-lg text-tinta-700">{QUEM_SOMOS.texto}</p>
      </div>

      <div class="relative" data-revelar>
        {/* proporção travada: nada pula quando a foto carrega */}
        <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-ceu-100 shadow-cartao">
          <Image
            src={foto}
            alt="Crianças do departamento infantil reunidas em um dos encontros."
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 768px) 30rem, 92vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="size-full object-cover"
          />
        </div>
        <Ovelha
          class="absolute -bottom-7 -left-4 w-24 drop-shadow-md sm:-left-6 sm:w-28"
          animada
        />
      </div>
    </div>
  </div>
</section>
