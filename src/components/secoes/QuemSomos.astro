---
import Ovelha from '../ilustracoes/Ovelha.astro';
import { QUEM_SOMOS } from '../../config/site';
---

<section class="secao" aria-labelledby="quem-somos">
  <div class="container-site">
    <div
      class="relative overflow-hidden rounded-3xl border border-borda bg-superficie px-6 py-10 shadow-suave md:px-12 md:py-14"
    >
      <div class="max-w-2xl">
        <h2 id="quem-somos" class="text-titulo text-texto">{QUEM_SOMOS.titulo}</h2>
        <p class="mt-5 text-corpo-lg text-tinta-700">{QUEM_SOMOS.texto}</p>
      </div>

      {/* ovelha discreta no canto, escondida no celular para não roubar espaço */}
      <Ovelha class="pointer-events-none absolute -right-4 -bottom-3 hidden w-40 opacity-60 lg:block" />
    </div>
  </div>
</section>
