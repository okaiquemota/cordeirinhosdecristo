---
import Galeria from '../Galeria.astro';
import Ovelha from '../ilustracoes/Ovelha.astro';
import { QUEM_SOMOS } from '../../config/site';
import foto from '../../assets/fotos/quem-somos.jpeg';
---

<section class="secao" aria-labelledby="quem-somos">
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div data-revelar>
        <h2 id="quem-somos" class="text-titulo text-texto">{QUEM_SOMOS.titulo}</h2>
        <div class="mt-5 space-y-4 text-corpo-lg text-tinta-700">
          {QUEM_SOMOS.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
        </div>
      </div>

      {/* No celular a foto entra primeiro; no desktop volta para a direita.
          A ordem do HTML continua texto-e-depois-foto, então o leitor de
          tela ouve o título antes. */}
      <div class="relative order-first md:order-none" data-revelar>
        {/* Mesmo lightbox da galeria do evento: clicar amplia, Esc fecha.
            A moldura sai da proporção do próprio arquivo, então trocar a foto
            por uma de outro formato não corta ninguém. */}
        <Galeria
          variante="unica"
          fotos={[
            {
              src: foto,
              alt: 'As crianças e a equipe dos Cordeirinhos de Cristo reunidas no salão da igreja, de camiseta do departamento, em frente ao arco de balões da festividade Tudo se fez novo.',
            },
          ]}
        />

        <Ovelha
          class="pointer-events-none absolute -bottom-7 -left-4 w-24 drop-shadow-md sm:-left-6 sm:w-28"
          animada
        />
      </div>
    </div>
  </div>
</section>
