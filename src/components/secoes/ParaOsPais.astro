---
import Ovelha from '../ilustracoes/Ovelha.astro';
import { PARA_OS_PAIS } from '../../config/site';
const { titulo, descricao, duvidas } = PARA_OS_PAIS;
---

{
  duvidas.length > 0 && (
    <section class="secao bg-creme-200" aria-labelledby="para-os-pais">
      <div class="container-site">
        <div class="flex items-start justify-between gap-8" data-revelar>
          <header class="max-w-2xl">
            <h2 id="para-os-pais" class="text-titulo text-texto">
              {titulo}
            </h2>
            <p class="mt-2 text-corpo-lg text-tinta-700">{descricao}</p>
          </header>
          {/* encostada na margem direita do container, alinhada ao título —
              solta no meio do texto ela parecia acidente */}
          <Ovelha class="pointer-events-none -mt-4 hidden w-28 shrink-0 lg:block" animada />
        </div>

        {/* lista de definição: a pergunta é o termo, a resposta é a definição.
            Sem JS e sem accordion — quatro respostas curtas cabem abertas. */}
        <dl data-revelar-grupo class="mt-9 grid gap-5 md:grid-cols-2">
          {duvidas.map((d) => (
            <div data-revelar class="rounded-2xl bg-superficie p-6 shadow-suave">
              <dt class="font-display text-lg font-700 text-texto">{d.pergunta}</dt>
              <dd class="mt-2 text-tinta-700">{d.resposta}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}
