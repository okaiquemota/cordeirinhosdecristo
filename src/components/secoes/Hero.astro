---
import { Image } from 'astro:assets';
import Nuvem from '../ilustracoes/Nuvem.astro';
import BordaNuvem from '../ilustracoes/BordaNuvem.astro';
import Botao from '../Botao.astro';
import Instagram from '../icones/Instagram.astro';
import { SITE, CONTATO, TEXTOS } from '../../config/site';
import logo from '../../assets/marca/logo-colorida.png';
---

{/* Céu com profundidade de verdade, em três planos:
    fundo  — nuvens pequenas, pálidas e lentas, atrás do conteúdo;
    meio   — a logo, o subtítulo e os botões;
    frente — nuvens grandes e brancas passando por cima, só nas faixas de
             cima e de baixo, para não atravessarem o texto.
    A diferença de tamanho, brilho e velocidade entre os planos é o que faz
    o céu parecer fundo e não papel de parede. */}
<section
  class="relative isolate flex min-h-[min(80svh,40rem)] flex-col justify-center overflow-hidden border-b border-fundo bg-clip-padding bg-linear-to-b from-ceu-500 via-ceu-300 to-ceu-200"
>
  {/* claridade quente vindo do alto, como sol fora do quadro */}
  <div
    class="pointer-events-none absolute -top-56 -right-24 -z-20 size-[42rem] rounded-full opacity-70 blur-2xl"
    style="background: radial-gradient(circle, rgb(255 253 249 / 0.7), transparent 62%)"
    aria-hidden="true"
  >
  </div>

  {/* plano de fundo */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <Nuvem
      class="absolute top-[16%] left-0 w-20 animate-deriva-lenta md:w-28"
      opacidade={0.4}
      atraso={-70}
    />
    <Nuvem
      class="absolute top-[52%] left-0 w-16 animate-deriva-lenta md:w-24"
      opacidade={0.32}
      atraso={-20}
    />
    <Nuvem
      class="absolute top-[34%] left-0 w-24 animate-deriva-media md:w-32"
      opacidade={0.38}
      atraso={-48}
    />
    <Nuvem
      class="absolute top-[70%] left-0 w-28 animate-deriva md:w-40"
      opacidade={0.3}
      atraso={-55}
    />
    <Nuvem
      class="absolute top-[8%] left-0 w-14 animate-deriva-media md:w-20"
      opacidade={0.45}
      atraso={-33}
    />
  </div>

  {/* plano do meio */}
  <div class="container-site relative z-10 flex flex-col items-center pt-10 pb-16 text-center md:pt-8 md:pb-20">
    {/* A logo É o título. O alt carrega o nome, então leitor de tela e
        buscador leem "Cordeirinhos de Cristo" como h1. */}
    <h1>
      <Image
        src={logo}
        alt={SITE.nome}
        widths={[320, 420, 520, 640, 832]}
        sizes="(min-width: 768px) 26rem, 76vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-[26rem] drop-shadow-[0_6px_18px_rgb(11_70_101/0.25)]"
      />
    </h1>

    {/* a frase do tema é a linha grande; o subtítulo vem embaixo, menor,
        dizendo de quem é a casa. Emoção primeiro, informação depois. */}
    {
      TEXTOS.capa.tema && (
        <p class="mt-4 max-w-lg font-display text-slogan font-800 text-tinta-900">
          {TEXTOS.capa.tema}
        </p>
      )
    }

    <p class="mt-3 max-w-md text-base leading-relaxed text-tinta-700 sm:text-lg">{SITE.subtitulo}</p>

    {/* min-w igual nos dois: sem isso cada botão fica do tamanho do próprio
        texto e a dupla sai torta. O valor cabe no mais largo dos dois e
        ainda passa folgado numa tela de 320px. */}
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Botao href="/#ultimos-eventos" tamanho="lg" class="min-w-52">
        Ver os eventos
      </Botao>
      {
        CONTATO.instagramUrl && (
          <Botao href={CONTATO.instagramUrl} tipo="claro" tamanho="lg" externo class="min-w-52">
            <Instagram class="size-5" />
            Instagram
          </Botao>
        )
      }
    </div>
  </div>

  {/* plano da frente: uma só, no alto e cortada pela borda de cima. É o
      tamanho e o corte que a fazem parecer perto — mas ela passa POR TRÁS
      do conteúdo (z-10 acima), porque em telas estreitas a faixa de cima
      alcança a logo e cobria a primeira letra. Havia outra embaixo, e
      aquela cobria o botão do Instagram; essa foi removida. */}
  <div class="pointer-events-none absolute inset-x-0 top-0 h-40 overflow-hidden" aria-hidden="true">
    <Nuvem class="absolute -top-20 left-0 w-56 animate-deriva md:-top-24 md:w-72" atraso={-14} />
  </div>

  {/* fora do fluxo: como flex child, o justify-center a centralizava e
      sobrava azul embaixo dela */}
  <div class="pointer-events-none absolute inset-x-0 bottom-0">
    <BordaNuvem class="text-fundo" virada />
  </div>
</section>
