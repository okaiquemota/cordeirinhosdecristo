---
import { Image } from 'astro:assets';
import Nuvem from '../ilustracoes/Nuvem.astro';
import BordaNuvem from '../ilustracoes/BordaNuvem.astro';
import Botao from '../Botao.astro';
import Seta from '../icones/Seta.astro';
import Instagram from '../icones/Instagram.astro';
import { SITE, CONTATO } from '../../config/site';
import logo from '../../assets/marca/logo-colorida.png';
---

{/* Céu de verdade, como a aplicação oficial da marca: azul vivo em cima
    clareando para o horizonte, nuvens grandes passando. O texto é escuro
    porque branco sobre esse azul dá 2.65:1 e reprovaria — tinta-900 sobre
    ceu-300 dá 8.62:1. */}
<section class="relative overflow-hidden bg-linear-to-b from-ceu-400 via-ceu-300 to-ceu-200">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Nuvem class="absolute top-4 left-0 w-48 animate-deriva md:w-72" opacidade={0.9} atraso={-16} />
    <Nuvem
      class="absolute top-36 left-0 w-32 animate-deriva-lenta md:top-52 md:w-48"
      opacidade={0.55}
      atraso={-62}
    />
    <Nuvem
      class="absolute top-20 left-0 w-24 animate-deriva-media md:w-36"
      opacidade={0.7}
      atraso={-34}
    />
    <Nuvem
      class="absolute bottom-20 left-0 hidden w-40 animate-deriva-lenta md:block"
      opacidade={0.4}
      atraso={-8}
    />
  </div>

  <div
    class="container-site relative flex flex-col items-center pt-10 pb-16 text-center md:pt-14 md:pb-24"
  >
    {/* A logo É o título. O alt carrega o nome, então leitor de tela e
        buscador leem "Cordeirinhos de Cristo" como h1. */}
    <h1>
      <Image
        src={logo}
        alt={SITE.nome}
        widths={[360, 540, 720, 960]}
        sizes="(min-width: 768px) 34rem, 88vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-[34rem]"
      />
    </h1>

    <p class="mt-7 max-w-lg text-subtitulo font-600 text-tinta-900">{SITE.subtitulo}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Botao href="/eventos/" tamanho="lg">
        Ver os eventos
        <Seta class="size-4" />
      </Botao>
      {
        CONTATO.instagramUrl && (
          <Botao href={CONTATO.instagramUrl} tipo="claro" tamanho="lg" externo>
            <Instagram class="size-5" />
            {CONTATO.instagram}
          </Botao>
        )
      }
    </div>
  </div>

  <BordaNuvem class="text-fundo -scale-y-100" />
</section>
