---
import Local from '../icones/Local.astro';
import Botao from '../Botao.astro';
import { Image } from 'astro:assets';
import { CONTATO, SITE, TEXTOS } from '../../config/site';
import fotoIgreja from '../../assets/fotos/igreja.jpeg';

const { endereco } = CONTATO;
const temEndereco = Boolean(endereco.logradouro || endereco.cidade);
---

<section class="secao" aria-labelledby="contato">
  <div class="container-site">
    <div data-revelar class="rounded-3xl bg-ceu-800 px-5 py-10 sm:px-8 md:px-12 md:py-14">
      <div class="mx-auto max-w-xl text-center">
        <h2 id="contato" class="text-titulo text-creme-50">{TEXTOS.contato.titulo}</h2>
        {
          TEXTOS.contato.descricao && (
            <p class="mt-3 text-corpo-lg text-ceu-100">{TEXTOS.contato.descricao}</p>
          )
        }
      </div>

      {/* A foto da igreja à esquerda, o endereço à direita: quem nunca veio
          reconhece o prédio antes de procurar a rua. Centralizados um em
          relação ao outro, porque a foto costuma ser mais alta que o cartão. */}
      <div class="mt-9 grid gap-6 md:mt-11 md:grid-cols-2 md:items-center md:gap-8">
        {/* No celular a foto sai: o cartão do endereço é o que a pessoa
            veio buscar, e a foto empurrava ele para baixo da dobra. */}
        {/* Aqui a foto não amplia: ela situa quem nunca veio, e quem quer
            ver o lugar de perto tem o botão do mapa ao lado. Por isso é uma
            imagem simples, sem o lightbox das outras. */}
        <div
          class="hidden overflow-hidden rounded-3xl bg-ceu-700 shadow-cartao md:block"
          style={`aspect-ratio: ${fotoIgreja.width} / ${fotoIgreja.height}`}
        >
          <Image
            src={fotoIgreja}
            alt={`Fachada da ${SITE.igreja}.`}
            width={1200}
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 768px) 30rem, 92vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="size-full object-cover"
          />
        </div>

        <div>
          {
            temEndereco && (
              <div class="flex flex-col rounded-2xl border border-creme-300/60 bg-superficie p-6 shadow-suave md:p-8">
                <span
                  class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-ceu-100 text-ceu-700"
                  aria-hidden="true"
                >
                  <Local class="size-5" />
                </span>

                {/* "Onde fica" vira rótulo discreto: quem manda na hierarquia
                    agora é o nome da igreja, e dois negritos do mesmo peso
                    empilhados brigariam. */}
                <h3 class="mt-4 font-display text-sm font-600 tracking-wide text-texto-suave uppercase">
                  {TEXTOS.contato.ondeFica}
                </h3>

                <address class="mt-2 not-italic">
                  <span class="block font-display text-xl leading-snug font-700 text-texto">
                    {SITE.igreja}
                  </span>

                  {endereco.logradouro && (
                    <span class="mt-2 block text-lg text-tinta-700">{endereco.logradouro}</span>
                  )}

                  {/* bairro, cidade e CEP: quem já sabe a rua não precisa
                      deles no mesmo tamanho */}
                  {endereco.bairro && (
                    <span class="block text-base text-texto-suave">{endereco.bairro}</span>
                  )}
                  <span class="block text-base text-texto-suave">
                    {[endereco.cidade, endereco.uf].filter(Boolean).join(' - ')}
                    {endereco.cep && ` · ${endereco.cep}`}
                  </span>
                </address>

                {endereco.mapaUrl && (
                  <Botao href={endereco.mapaUrl} externo class="mt-6 self-start">
                    Ver no mapa
                  </Botao>
                )}
              </div>
            )
          }

        </div>
      </div>
    </div>
  </div>
</section>
