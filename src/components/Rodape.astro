---
import { Image } from 'astro:assets';
import logoBranca from '../assets/marca/logo-branca.png';
import BordaNuvem from './ilustracoes/BordaNuvem.astro';
import Local from './icones/Local.astro';
import Telefone from './icones/Telefone.astro';
import Instagram from './icones/Instagram.astro';
import WhatsApp from './icones/WhatsApp.astro';
import { SITE, CONTATO, RODAPE, NAVEGACAO, TEXTOS } from '../config/site';

const { endereco } = CONTATO;
const ano = new Date().getFullYear();
const temEndereco = Boolean(endereco.logradouro || endereco.cidade);

const tituloColuna = 'font-display text-base font-700 text-creme-50';
const link =
  'inline-block text-ceu-100 transition duration-200 ease-saida hover:text-creme-50 active:scale-95 active:duration-75';
/* linha com ícone à esquerda e o conteúdo alinhado pelo topo */
const linha = 'flex gap-3';
const icone = 'mt-0.5 size-5 shrink-0 text-ceu-200';
const rede =
  'inline-flex size-11 items-center justify-center rounded-xl bg-ceu-700 text-creme-100 transition duration-200 ease-saida hover:bg-ceu-600 hover:text-creme-50 active:scale-90 active:duration-75';
---

<footer class="mt-4 border-t border-fundo bg-ceu-800 bg-clip-padding text-creme-100">
  {/* a nuvem é desenhada na cor do fundo da página e transborda para baixo,
      então o azul do rodapé parece começar logo abaixo dela */}
  <BordaNuvem class="text-fundo" />

  <div class="container-site relative pt-12 pb-10 md:pt-16">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr] md:gap-8">
      <div>
        <Image
          src={logoBranca}
          alt={`${SITE.nome}, ${SITE.igreja}`}
          widths={[240, 360, 480]}
          sizes="11rem"
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-auto w-40 max-w-full sm:w-44"
        />
        {/* a mesma frase do tema que abre a capa; trocar lá troca aqui */}
        <p class="mt-4 max-w-xs text-sm text-ceu-100">{TEXTOS.capa.tema}</p>

        <div class="mt-5 flex gap-3">
          {
            CONTATO.instagram && (
              <a href={CONTATO.instagramUrl} target="_blank" rel="noopener noreferrer" class={rede}>
                <Instagram class="size-5" />
                <span class="sr-only">Instagram do departamento, abre em nova aba</span>
              </a>
            )
          }

          {
            CONTATO.whatsapp && (
              <a
                href={`https://wa.me/${CONTATO.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class={rede}
              >
                <WhatsApp class="size-5" />
                <span class="sr-only">
                  WhatsApp {CONTATO.telefone}, abre em nova aba
                </span>
              </a>
            )
          }
        </div>
      </div>

      <nav aria-labelledby="rodape-navegacao">
        <h2 id="rodape-navegacao" class={tituloColuna}>{NAVEGACAO.titulo}</h2>
        <ul class="mt-4 space-y-3">
          {
            NAVEGACAO.itens.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 id="rodape-contato" class={tituloColuna}>{RODAPE.contato.titulo}</h2>

        <ul class="mt-4 space-y-4">
          {
            temEndereco && (
              <li class={linha}>
                <Local class={icone} />
                <address class="text-ceu-100 not-italic">
                  {endereco.logradouro && <span class="block">{endereco.logradouro}</span>}
                  {endereco.bairro && <span class="block">{endereco.bairro}</span>}
                  <span class="block">
                    {[endereco.cidade, endereco.uf].filter(Boolean).join(' - ')}
                    {endereco.cep && ` · ${endereco.cep}`}
                  </span>
                </address>
              </li>
            )
          }

          {/* aparece sozinho quando o telefone entrar no site.ts */}
          {
            CONTATO.whatsapp && (
              <li class={linha}>
                <Telefone class={icone} />
                <a
                  href={`https://wa.me/${CONTATO.whatsapp}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={link}
                >
                  {CONTATO.telefone || 'WhatsApp'}
                </a>
              </li>
            )
          }
        </ul>

      </div>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-ceu-600 pt-6 text-sm text-ceu-200"
    >
      <p>© {ano} {SITE.nome} · {SITE.igreja}</p>
      <p>{RODAPE.credito}</p>
    </div>
  </div>
</footer>
