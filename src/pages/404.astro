---
import PaginaLayout from '../layouts/PaginaLayout.astro';
import Botao from '../components/Botao.astro';
import Ovelha from '../components/ilustracoes/Ovelha.astro';
import Nuvem from '../components/ilustracoes/Nuvem.astro';
import Seta from '../components/icones/Seta.astro';
---

<PaginaLayout
  titulo="Página não encontrada"
  descricao="Esta página não existe ou mudou de endereço."
  naoIndexar
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-56" aria-hidden="true">
      <Nuvem
        class="absolute top-6 left-0 w-44 text-creme-50 animate-deriva md:w-60"
        opacidade={0.8}
        atraso={-20}
      />
      <Nuvem
        class="absolute top-24 left-0 w-28 text-creme-50 animate-deriva-lenta md:w-36"
        opacidade={0.55}
        atraso={-64}
      />
    </div>

    <div class="container-site relative flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
      <Ovelha class="w-36 md:w-44" animada />

      <h1 class="mt-8 text-titulo text-texto">Essa ovelhinha se perdeu</h1>
      <p class="mt-3 max-w-md text-corpo-lg text-tinta-700">
        A página que você procurou não existe ou mudou de endereço. Se o link veio de alguma
        conversa antiga, pode ser que ele seja de antes.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Botao href="/" tamanho="lg">
          Voltar para o início
          <Seta class="size-4" />
        </Botao>
        <Botao href="/#ultimos-eventos" tipo="secundaria" tamanho="lg">Ver os eventos</Botao>
      </div>
    </div>
  </section>
</PaginaLayout>
