---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import PaginaLayout from '../../layouts/PaginaLayout.astro';
import Botao from '../../components/Botao.astro';
import Galeria from '../../components/Galeria.astro';
import Seta from '../../components/icones/Seta.astro';
import { listarEventos, nomeTransicaoCapa } from '../../lib/eventos';
import { periodo, dataISO } from '../../lib/datas';
import { urlOg } from '../../lib/og';
import { SITE, CONTATO } from '../../config/site';

export const getStaticPaths = (async () => {
  const eventos = await listarEventos();
  return eventos.map((evento) => ({
    params: { slug: evento.id },
    props: { evento },
  }));
}) satisfies GetStaticPaths;

const { evento } = Astro.props;
const { titulo, data, dataFim, resumo, capa, galeria, linkDrive } = evento.data;
const { Content } = await render(evento);
const ogImagem = await urlOg(capa.src, Astro.site);

/* Dado estruturado de evento: é o que permite ao Google mostrar a data e o
   local junto do resultado da busca, em vez de só o título e o resumo. */
const { endereco } = CONTATO;
const dadosEvento = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: titulo,
  description: resumo,
  startDate: dataISO(data),
  ...(dataFim ? { endDate: dataISO(dataFim) } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: [ogImagem],
  location: {
    '@type': 'Place',
    name: SITE.igreja,
    address: {
      '@type': 'PostalAddress',
      streetAddress: endereco.logradouro,
      addressLocality: endereco.cidade,
      addressRegion: endereco.uf,
      postalCode: endereco.cep,
      addressCountry: 'BR',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: SITE.nome,
    url: SITE.url,
  },
};
---

<PaginaLayout titulo={titulo} descricao={resumo} ogImagem={ogImagem} tipoOg="article">
  <article>
    {/* ── capa ─────────────────────────────────────────────────────── */}
    <div class="container-site pt-6 md:pt-8">
      <a
        href="/#ultimos-eventos"
        class="inline-flex items-center gap-1.5 rounded-full py-2 font-display font-600 text-primaria transition hover:text-primaria-forte"
      >
        <Seta class="size-4 rotate-180" />
        Todos os eventos
      </a>
    </div>

    <header class="container-site pt-4 pb-8 md:pt-6 md:pb-12">
      {/* A capa não é recortada nem esticada: quem manda é o teto de altura,
          e a largura segue a proporção do arquivo. Ocupando a largura toda do
          container, uma capa 8/5 passava de 700px de altura e não cabia na
          tela; recortar resolveria a altura, mas comeria pedaço de foto de
          grupo e cortaria o título de um cartaz. */}
      <div class="flex justify-center">
        <Image
          src={capa.src}
          alt={capa.alt}
          widths={[480, 768, 1080, 1440, 1920]}
          sizes="(min-width: 64rem) 58rem, 100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          transition:name={nomeTransicaoCapa(evento)}
          class="h-auto max-h-[min(72svh,36rem)] w-auto max-w-full rounded-3xl bg-creme-200 shadow-alta"
        />
      </div>

      <div class="mt-7 max-w-3xl">
        <time
          datetime={dataISO(data)}
          class="inline-block rounded-full bg-ceu-100 px-3 py-1 font-display text-sm font-600 text-ceu-800"
        >
          {periodo(data, dataFim)}
        </time>
        <h1 class="mt-3 text-titulo text-texto">{titulo}</h1>
        <p class="mt-3 text-corpo-lg text-tinta-700">{resumo}</p>
      </div>
    </header>

    {/* ── texto ────────────────────────────────────────────────────── */}
    <div class="container-site">
      <div class="prosa max-w-2xl">
        <Content />
      </div>
    </div>

    {/* ── galeria ──────────────────────────────────────────────────── */}
    {
      galeria.length > 0 && (
        <section class="container-site mt-14 md:mt-20" aria-labelledby="galeria">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 id="galeria" class="text-subtitulo text-texto">
                Fotos do dia
              </h2>
              <p class="mt-1 text-texto-suave">
                {galeria.length} {galeria.length === 1 ? 'foto' : 'fotos'} aqui.
                {linkDrive && ' O álbum completo está no Drive.'}
              </p>
            </div>

            {linkDrive && (
              <Botao href={linkDrive} tipo="rosa" tamanho="lg" externo>
                Ver todas as fotos
                <Seta class="size-4" />
              </Botao>
            )}
          </div>

          <div class="mt-6">
            <Galeria fotos={galeria} />
          </div>
        </section>
      )
    }

    {/* ── botão do Drive, quando não há galeria no site ─────────────── */}
    {
      galeria.length === 0 && linkDrive && (
        <div class="container-site mt-12 text-center">
          <Botao href={linkDrive} tipo="rosa" tamanho="lg" externo>
            Ver todas as fotos
            <Seta class="size-4" />
          </Botao>
        </div>
      )
    }
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(dadosEvento)} />
</PaginaLayout>
