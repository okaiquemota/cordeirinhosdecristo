---
import PaginaLayout from '../../layouts/PaginaLayout.astro';
import CardEvento from '../../components/CardEvento.astro';
import { listarEventos } from '../../lib/eventos';
import { urlOg } from '../../lib/og';
import foto from '../../assets/fotos/quem-somos.jpeg';

const eventos = await listarEventos();
const ogImagem = await urlOg(foto, Astro.site);

const descricao =
  'Todas as festividades e encontros do departamento infantil Cordeirinhos ' +
  'de Cristo, com as fotos de cada dia.';
---

<PaginaLayout titulo="Eventos" descricao={descricao} ogImagem={ogImagem}>
  <div class="container-site py-10 md:py-14">
    <header class="max-w-2xl">
      <h1 class="text-titulo text-texto">Eventos</h1>
      <p class="mt-3 text-corpo-lg text-tinta-700">
        Cada festividade e cada encontro que registramos, do mais recente para o mais antigo.
      </p>
    </header>

    {
      eventos.length > 0 ? (
        <ul
          data-revelar-grupo
          class:list={[
            'mt-10 grid gap-6',
            eventos.length === 1
              ? 'grid-cols-1'
              : eventos.length === 2
                ? 'sm:grid-cols-2'
                : 'sm:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {eventos.map((evento, i) => (
            <li class="flex">
              <CardEvento
                evento={evento}
                prioridade={i < 2}
                variante={eventos.length === 1 ? 'destaque' : 'grade'}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 rounded-2xl border border-borda bg-superficie p-6 text-tinta-700">
          Ainda não há eventos publicados.
        </p>
      )
    }
  </div>
</PaginaLayout>
