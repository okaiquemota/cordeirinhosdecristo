---
import BaseLayout from './BaseLayout.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import RevelarAoRolar from '../components/RevelarAoRolar.astro';
import RolagemSuave from '../components/RolagemSuave.astro';

interface Props {
  titulo: string;
  descricao?: string;
  ogImagem?: string;
  naoIndexar?: boolean;
  tipoOg?: 'website' | 'article';
}
const props = Astro.props;
---

<BaseLayout {...props}>
  <Cabecalho />
  <main id="conteudo">
    <slot />
  </main>
  <Rodape />
  <RevelarAoRolar />
<RolagemSuave />
</BaseLayout>
